<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" prefWidth="380"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.java.controllers.OrdreController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label fx:id="lblTitle" text="Ordre"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints prefWidth="220" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Montant total -->
        <Label text="Montant Total (€) *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="tfTotalAmount" promptText="ex: 1500.00"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- ID Acheteur -->
        <Label text="ID Acheteur *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="tfBuyerId" promptText="ex: 40"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler"        onAction="#handleAnnuler"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-min-width: 90px;"/>
        <Button text="💾 Sauvegarder" onAction="#handleSauvegarder"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-min-width: 120px;"/>
    </HBox>

</VBox>
