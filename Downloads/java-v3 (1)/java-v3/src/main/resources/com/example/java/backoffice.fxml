<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.java.controllers.BackofficeController"
      styleClass="page-root"
      spacing="0">

    <!-- ══════════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════════ -->
    <VBox styleClass="bo-sidenav" prefWidth="230" minWidth="210" spacing="0">
        <padding><Insets top="24" bottom="24"/></padding>

        <Label text="Artera"     styleClass="bo-logo"/>
        <Label text="Backoffice" styleClass="bo-subtitle"/>

        <Region prefHeight="28"/>
        <Separator styleClass="bo-sep"/>
        <Region prefHeight="16"/>

        <!-- Marketplace -->
        <Label text="MARKETPLACE"
               style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 10px;
                      -fx-font-weight: bold; -fx-padding: 0 24 6 24;"/>

        <Button fx:id="navDashboard"
                text="📊  Tableau de bord"
                styleClass="bo-nav-btn"
                onAction="#showDashboard"
                maxWidth="Infinity"/>

        <Button fx:id="navMarketplace"
                text="🖼️  Modérer les publications"
                styleClass="bo-nav-btn"
                onAction="#showMarketplace"
                maxWidth="Infinity"/>

        <!-- navOrdres et navLignes supprimés :
             les commandes sont générées automatiquement par le checkout user -->

        <!-- Espace bas -->
        <Region VBox.vgrow="ALWAYS"/>
        <Separator styleClass="bo-sep"/>
        <Region prefHeight="12"/>

        <Label text="v1.0.0 – Artera Platform"
               style="-fx-text-fill: rgba(255,255,255,0.30); -fx-font-size: 10px;
                      -fx-padding: 0 24 0 24;"/>
    </VBox>

    <!-- ══════════════════════════════════════════
         ZONE PRINCIPALE
    ══════════════════════════════════════════ -->
    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" spacing="0">

        <!-- Top bar -->
        <HBox styleClass="bo-topbar" alignment="CENTER_LEFT" spacing="16">
            <Label fx:id="pageTitle" text="Tableau de bord" styleClass="bo-page-title"/>
        </HBox>

        <!-- Contenu dynamique -->
        <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"/>

    </VBox>
</HBox>
