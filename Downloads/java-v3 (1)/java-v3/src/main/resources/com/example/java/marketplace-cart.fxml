<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.java.controllers.MarketplaceCartController"
      styleClass="u-cart-root">

    <!-- ── En-tête ── -->
    <VBox spacing="4">
        <padding><Insets top="28" right="40" bottom="18" left="40"/></padding>
        <Label text="🛒  Mon Panier" styleClass="u-cart-title"/>
        <Label text="Vérifiez vos articles avant de passer commande."
               styleClass="u-cart-subtitle"/>
    </VBox>

    <!-- ── Contenu ── -->
    <HBox spacing="28" VBox.vgrow="ALWAYS">
        <padding><Insets right="40" bottom="32" left="40"/></padding>

        <!-- Zone cartes articles -->
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
                    styleClass="u-grid-scroll">
            <VBox fx:id="cartContainer" spacing="12">
                <padding><Insets top="4" bottom="4"/></padding>
            </VBox>
        </ScrollPane>

        <!-- Colonne droite : résumé + promo -->
        <VBox spacing="16" prefWidth="290" minWidth="260" alignment="TOP_CENTER">

            <!-- ── Récapitulatif ── -->
            <VBox styleClass="u-cart-summary" spacing="14">
                <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                <Label text="Récapitulatif"
                       style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#2c2218;"/>
                <Separator/>

                <Label fx:id="lblTotal" text="Total : 0,00 €" styleClass="u-cart-total"/>
                <Label fx:id="lblTotalWithPromo" text="" styleClass="u-cart-total"
                       style="-fx-text-fill:#2d6a4f;" visible="false"/>

                <Button fx:id="btnCommander"
                        text="💳  Payer avec Stripe"
                        styleClass="u-btn-primary"
                        onAction="#handleCommander"
                        maxWidth="Infinity" prefHeight="46" disable="true"/>

                <Button fx:id="btnContinuer"
                        text="← Continuer mes achats"
                        styleClass="u-btn-ghost"
                        onAction="#handleContinuer"
                        maxWidth="Infinity"/>

                <Separator/>

                <Button fx:id="btnVider"
                        text="🗑  Vider le panier"
                        styleClass="u-btn-danger-ghost"
                        onAction="#handleVider"
                        maxWidth="Infinity" disable="true"/>
            </VBox>

            <!-- ── Code Promo ── -->
            <VBox spacing="10"
                  style="-fx-background-color:white; -fx-border-color:#d4cfc7; -fx-border-width:1;
                         -fx-border-radius:12; -fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(74,55,40,0.07),10,0,0,3);">
                <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>

                <Label text="🏷️  Code Promo"
                       style="-fx-font-size:13px; -fx-font-weight:bold; -fx-text-fill:#2c2218;"/>
                <Label text="Vous avez reçu un code promo par email ? Saisissez-le ici."
                       style="-fx-font-size:11px; -fx-text-fill:#7a6a5a;" wrapText="true"/>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="tfPromoCode"
                               promptText="Ex : ARTERA-AB12CD"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:#fdf9f5; -fx-border-color:#d4cfc7;
                                      -fx-border-radius:8; -fx-background-radius:8;
                                      -fx-font-size:12px; -fx-padding:8 10 8 10;"/>
                    <Button fx:id="btnApplyPromo"
                            text="Appliquer"
                            onAction="#handleApplyPromo"
                            style="-fx-background-color:#4a3728; -fx-text-fill:white;
                                   -fx-font-size:12px; -fx-font-weight:bold;
                                   -fx-border-radius:8; -fx-background-radius:8;
                                   -fx-padding:8 14 8 14; -fx-cursor:hand;"/>
                </HBox>

                <Label fx:id="lblPromoStatus" text="" wrapText="true" visible="false"
                       style="-fx-font-size:11px; -fx-text-fill:#2d6a4f;"/>
            </VBox>

            <!-- ── Info email promo ── -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color:#f0f4ff; -fx-border-color:#b0c4de;
                         -fx-border-radius:10; -fx-background-radius:10;
                         -fx-padding:12 14 12 14; -fx-border-width:1;">
                <Label text="📧" style="-fx-font-size:16px;"/>
                <Label text="Après votre achat, recevez un code promo QR par email pour -30% sur votre prochaine commande !"
                       wrapText="true"
                       style="-fx-font-size:11px; -fx-text-fill:#3a5a8a;"/>
            </HBox>

        </VBox>
    </HBox>

</VBox>
