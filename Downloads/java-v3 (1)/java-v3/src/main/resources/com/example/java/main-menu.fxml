<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" prefWidth="400" prefHeight="300" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.java.controllers.MainMenuController">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="🎨 Artera – Gestion Marketplace"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Separator/>

    <Button text="🛒  MarketplacePosts" onAction="#ouvrirMarketplacePosts"
            maxWidth="Infinity"
            style="-fx-font-size: 15px; -fx-background-color: #3F51B5; -fx-text-fill: white; -fx-pref-height: 45px;"/>

    <Button text="📦  Ordres" onAction="#ouvrirOrdres"
            maxWidth="Infinity"
            style="-fx-font-size: 15px; -fx-background-color: #009688; -fx-text-fill: white; -fx-pref-height: 45px;"/>

    <Button text="📋  Lignes d'Ordre" onAction="#ouvrirLignesOrdre"
            maxWidth="Infinity"
            style="-fx-font-size: 15px; -fx-background-color: #FF5722; -fx-text-fill: white; -fx-pref-height: 45px;"/>

</VBox>
