<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" prefWidth="440"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.java.controllers.LigneOrdreController"
      style="-fx-background-color: #f5f3ef; -fx-padding: 24;">

    <Label fx:id="lblTitle" text="Ligne d'Ordre"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c2218;"/>

    <Separator/>

    <GridPane hgap="12" vgap="14">
        <columnConstraints>
            <ColumnConstraints prefWidth="155"/>
            <ColumnConstraints prefWidth="240" hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Ordre (ComboBox) -->
        <Label text="Commande *" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-size: 13px; -fx-text-fill: #4a3728; -fx-font-weight: bold;"/>
        <ComboBox fx:id="cbOrdreId" maxWidth="Infinity" promptText="Sélectionner une commande…"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- MarketplacePost (ComboBox) -->
        <Label text="Publication *" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-size: 13px; -fx-text-fill: #4a3728; -fx-font-weight: bold;"/>
        <ComboBox fx:id="cbMarketplacePostId" maxWidth="Infinity" promptText="Sélectionner un post…"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Prix achat -->
        <Label text="Prix à l'achat (€) *" GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-font-size: 13px; -fx-text-fill: #4a3728; -fx-font-weight: bold;"/>
        <TextField fx:id="tfPriceAtPurchase" promptText="Pré-rempli depuis le post…"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"
                   style="-fx-background-color: #ebe8e2; -fx-border-color: #d4cfc7;
                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;"/>

        <!-- Quantité -->
        <Label text="Quantité *" GridPane.rowIndex="3" GridPane.columnIndex="0"
               style="-fx-font-size: 13px; -fx-text-fill: #4a3728; -fx-font-weight: bold;"/>
        <TextField fx:id="tfQuantity" promptText="ex : 1"
                   GridPane.rowIndex="3" GridPane.columnIndex="1"
                   style="-fx-background-color: #ebe8e2; -fx-border-color: #d4cfc7;
                          -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12 8 12;"/>
    </GridPane>

    <Separator/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Annuler"         onAction="#handleAnnuler"
                style="-fx-background-color: transparent; -fx-border-color: #d4cfc7;
                       -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width:1;
                       -fx-text-fill: #7a6a5a; -fx-padding: 9 20 9 20; -fx-cursor: hand;"/>
        <Button text="💾  Sauvegarder" onAction="#handleSauvegarder"
                style="-fx-background-color: #4a3728; -fx-border-color: transparent;
                       -fx-border-radius: 8; -fx-background-radius: 8;
                       -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 9 20 9 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>
